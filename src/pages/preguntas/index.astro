---
import Layout from "../../layouts/Layout.astro";
import config from "../../data/site-config.json";
import { generateSchema } from "../../lib/schemaGenerator.js";
import faqs from "../../data/faqs.json";
import PreguntasList from "../../components/sections/preguntas/PreguntasList.astro";
import buscadorScript from "../../scripts/buscador-faq.js?url";
import preguntasScript from "../../scripts/preguntas.js?url";

/* ===========================
   COMBINAR Y DESDUPLICAR PREGUNTAS
=========================== */
const rawFaqs = [
    ...(faqs.home ?? []),
    ...(faqs.tarifas ?? []),
    ...(faqs.localidades ?? []),
    ...(faqs.localidad ?? []),
    ...(faqs.contacto ?? []),
    ...(faqs.preguntas ?? []),
    ...(faqs.tarifa?.fibra ?? []),
    ...(faqs.tarifa?.movil ?? []),
    ...(faqs.tarifa?.["fibra-movil"] ?? []),
];

// Eliminamos preguntas duplicadas filtrando por el texto de la pregunta (q)
// Esto mantiene el HTML limpio y evita penalizaciones SEO por contenido repetido
const allFaqs = Array.from(
    new Map(rawFaqs.map((item) => [item.q, item])).values(),
);

/* ===========================
   SCHEMA SEO (FAQPage)
=========================== */
const schema = generateSchema(
    {
        type: "FAQPage",
        data: { faqs: allFaqs },
    },
    config,
    Astro.url,
);
---

<Layout
    title={`Preguntas frecuentes | ${config.companyName}`}
    description={`Todas las respuestas a tus dudas sobre tarifas, cobertura y servicios de fibra y móvil de ${config.companyName}.`}
    schema={schema}
>
    <main class="pt-28 pb-24 container mx-auto px-6">
        <div
            class="grid md:grid-cols-2 items-center gap-10 max-w-5xl mx-auto mb-16"
        >
            <div class="text-center md:text-left">
                <h1
                    class="text-4xl md:text-5xl font-heading font-extrabold text-primary-600 mb-6 tracking-tight"
                >
                    Preguntas frecuentes
                </h1>
                <p class="text-lg text-gray-600 mb-10 max-w-lg mx-auto md:mx-0">
                    ¿Tienes alguna duda? Hemos recopilado las preguntas más
                    comunes de nuestros clientes para ayudarte rápidamente a
                    encontrar lo que buscas.
                </p>

                <div class="relative max-w-md mx-auto md:mx-0">
                    <label for="faq-search" class="sr-only"
                        >Buscar una pregunta</label
                    >
                    <div
                        class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
                    >
                        <svg
                            class="h-6 w-6 text-gray-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            ></path>
                        </svg>
                    </div>
                    <input
                        id="faq-search"
                        type="search"
                        placeholder="Busca una pregunta (ej. router...)"
                        class="w-full pl-12 pr-5 py-4 border border-gray-200 rounded-2xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all text-gray-700 bg-gray-50 focus:bg-white text-lg"
                    />
                </div>
            </div>

            <div class="flex justify-center md:justify-end">
                <img
                    src="/images/Cocofibra-preguntas.webp"
                    alt="Mascota CocoFibra resolviendo dudas"
                    class="w-[200px] md:w-[280px] drop-shadow-md"
                    loading="lazy"
                />
            </div>
        </div>

        <div class="max-w-4xl mx-auto">
            <PreguntasList preguntas={allFaqs} />
        </div>
    </main>

    <script type="module" src={buscadorScript}></script>
    <script type="module" src={preguntasScript}></script>
</Layout>
