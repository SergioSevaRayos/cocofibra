---
import Layout from "../../layouts/Layout.astro";
import config from "../../data/site-config.json";
import tarifas from "../../data/tarifas.json";
import CTA from "../../components/ui/CTA.astro";
import PreguntasSection from "../../components/sections/preguntas/PreguntasSection.astro";
import { generateSchema } from "../../lib/schemaGenerator.js";
import faqs from "../../data/faqs.json";
import preguntasScript from "/src/scripts/preguntas.js?url";


import tarifaPageScript from "/src/scripts/tarifaPage.js?url";
import tarifaAnimScript from "/src/scripts/tarifa-anim.js?url";

/* ===========================
   TIPOS SEGUROS
=========================== */
type CategoriaTarifa = "fibra-movil" | "fibra" | "movil";

interface Tarifa {
    title: string;
    slug: string;
    description: string;
    price: string;
    category: CategoriaTarifa;
    features: string[];
}

/* ===========================
   STATIC PATHS
=========================== */
export async function getStaticPaths() {
    return (tarifas as Tarifa[]).map((t) => ({
        params: { slug: t.slug },
        props: { tarifa: t },
    }));
}

/* ===========================
   OBTENCIÓN SEGURA DE TARIFA
=========================== */
function getTarifa(): Tarifa {
    if (Astro.props.tarifa) return Astro.props.tarifa as Tarifa;

    const { slug } = Astro.params;
    const found = (tarifas as Tarifa[]).find((t) => t.slug === slug);

    if (!found) {
        throw new Error(`Tarifa no encontrada: slug="${slug}"`);
    }

    return found;
}

const tarifa = getTarifa();

/* ===========================
   FAQs TARIFA (ESPECÍFICAS + GENERALES)
=========================== */

// Array específico según categoría de tarifa
const faqsEspecificas = faqs.tarifa[tarifa.category] ?? [];

// FAQs generales del apartado tarifas
const faqsGenerales = faqs.tarifas ?? [];

// 👉 Aquí declaramos explícitamente faqsTarifa
const faqsTarifa: { q: string; a: string }[] = [
    ...faqsEspecificas,
    ...faqsGenerales,
];

/* ===========================
   SCHEMA SEO
=========================== */
const schema = generateSchema(
    {
        type: "Product",
        data: {
            name: tarifa.title,
            description: tarifa.description,
            url: `/tarifas/${tarifa.slug}`,
            offers: {
                "@type": "Offer",
                price: tarifa.price.replace(",", "."),
                priceCurrency: "EUR",
            },
        },
    },
    config,
    Astro.url,
);
---

<Layout
    title={`${tarifa.title} | ${config.companyName}`}
    description={tarifa.description}
    schema={schema}
>
    <main class="pt-28 pb-24">
        <!-- HERO PREMIUM (IGUAL ESTILO QUE COBERTURA) -->
        <section class="container mx-auto px-6 text-center mb-16">
            <h1
                class="text-4xl md:text-5xl font-heading font-bold text-primary-600"
            >
                {tarifa.title}
            </h1>

            <p class="mt-4 text-accent-600 text-lg max-w-3xl mx-auto">
                {tarifa.description}
            </p>

            <a
                href="/contacto"
                class="inline-block bg-primary-500 text-white px-8 py-4 rounded-xl font-semibold mt-8 shadow-gym-card hover:bg-primary-600 transition"
            >
                Contratar ahora
            </a>
        </section>

        <!-- TARJETA PREMIUM DOBLE COLUMNA (MISMO DISEÑO QUE TENÍAS) -->
        <section class="container mx-auto px-6 mb-20">
            <div class="grid md:grid-cols-2 gap-10">
                <!-- COLUMNA IZQUIERDA: FEATURES -->
                <div
                    class="bg-white rounded-3xl shadow-gym-lg ring-1 ring-black/5 overflow-hidden"
                >
                    <div
                        class="bg-primary-600 text-white text-center py-4 text-xl font-semibold"
                    >
                        Qué incluye esta tarifa
                    </div>

                    <div class="p-8 space-y-6">
                        {
                            tarifa.features.map((f, i) => (
                                <div
                                    class="flex items-start gap-4 opacity-0 translate-y-2"
                                    data-anim={`feat-${i}`}
                                >
                                    <span class="inline-block w-3 h-3 bg-primary-500 rounded-full mt-2" />
                                    <p class="text-accent-800">{f}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- COLUMNA DERECHA: PRECIO + CTA -->
                <div
                    class="bg-white rounded-3xl shadow-gym-lg ring-1 ring-black/5 overflow-hidden"
                >
                    <div
                        class="bg-primary-600 text-white py-4 text-center font-semibold text-lg"
                    >
                        Contrata {
                            tarifa.category === "fibra-movil"
                                ? "Fibra + Móvil"
                                : "Fibra"
                        }
                    </div>

                    <div class="p-8 space-y-6">
                        <h2
                            class="text-xl font-semibold text-accent-800 text-center"
                        >
                            {tarifa.title}
                        </h2>

                        <div class="text-center">
                            <p class="text-4xl font-bold text-primary-600">
                                {tarifa.price}
                            </p>
                            <p class="text-gray-600 text-sm">/mes</p>
                        </div>

                        <div class="text-center">
                            <CTA
                                href="/contacto"
                                label="Contratar ahora"
                                variant="cta"
                                size="lg"
                                class="w-full"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- IVA -->
        <section class="mt-20">
            <div class="bg-primary-50 py-10 text-center rounded-xl">
                <h3 class="font-semibold text-accent-800 text-lg">
                    Todos nuestros precios incluyen IVA
                </h3>
                <p class="text-gray-600 text-sm">Sin sorpresas en tu factura</p>
            </div>
        </section>
        <PreguntasSection preguntas={faqsTarifa} />

        <!-- ANIMACIONES SEPARADAS -->
    </main>

    <script type="module" src={tarifaPageScript}></script>
    <script type="module" src={tarifaAnimScript}></script>
    <script type="module" src={preguntasScript}></script>

</Layout>
