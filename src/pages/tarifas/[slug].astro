---
import Layout from "../../layouts/Layout.astro";
import config from "../../data/site-config.json";
import tarifas from "../../data/tarifas.json";
import CTA from "../../components/ui/CTA.astro";
import PreguntasSection from "../../components/sections/preguntas/PreguntasSection.astro";
import { generateSchema } from "../../lib/schemaGenerator.js";
import faqs from "../../data/faqs.json";
import preguntasScript from "/src/scripts/preguntas.js?url";

import tarifaPageScript from "/src/scripts/tarifaPage.js?url";
import tarifaAnimScript from "/src/scripts/tarifa-anim.js?url";

/* ===========================
   TIPOS SEGUROS
=========================== */
type CategoriaTarifa = "fibra-movil" | "fibra" | "movil";

interface Tarifa {
    title: string;
    slug: string;
    description: string;
    price: string;
    category: CategoriaTarifa;
    features: string[];
}

/* ===========================
   STATIC PATHS
=========================== */
export async function getStaticPaths() {
    return (tarifas as Tarifa[]).map((t) => ({
        params: { slug: t.slug },
        props: { tarifa: t },
    }));
}

/* ===========================
   OBTENCIÓN SEGURA DE TARIFA
=========================== */
function getTarifa(): Tarifa {
    if (Astro.props.tarifa) return Astro.props.tarifa as Tarifa;

    const { slug } = Astro.params;
    const found = (tarifas as Tarifa[]).find((t) => t.slug === slug);

    if (!found) {
        throw new Error(`Tarifa no encontrada: slug="${slug}"`);
    }

    return found;
}

const tarifa = getTarifa();

/* ===========================
   LÓGICA DE ICONOS / FORMATO
=========================== */
const isFibra = tarifa.category.includes("fibra");
const isMovil = tarifa.category.includes("movil");

const categoriaLabel = 
    tarifa.category === "fibra-movil" ? "Fibra + Móvil" : 
    tarifa.category === "fibra" ? "Fibra" : "Móvil";

/* ===========================
   FAQs TARIFA
=========================== */
const faqsEspecificas = faqs.tarifa?.[tarifa.category] ?? [];
const faqsGenerales = faqs.tarifas ?? [];
const faqsTarifa: { q: string; a: string }[] = [
    ...faqsEspecificas,
    ...faqsGenerales,
];

/* ===========================
   SCHEMA SEO (Product + FAQPage)
=========================== */
const productSchema = generateSchema(
    {
        type: "Product",
        data: {
            name: tarifa.title,
            description: tarifa.description,
            url: `/tarifas/${tarifa.slug}`,
            offers: {
                "@type": "Offer",
                price: tarifa.price.replace(" €", "").replace(",", "."),
                priceCurrency: "EUR",
            },
        },
    },
    config,
    Astro.url,
);

const faqSchema = generateSchema(
    {
        type: "FAQPage",
        data: { faqs: faqsTarifa }
    },
    config,
    Astro.url
);

const schema = [productSchema, faqSchema];
---
<Layout
    title={`${tarifa.title} | ${config.companyName}`}
    description={tarifa.description}
    schema={schema}
>
    <main class="pt-28 pb-24">
        <section class="container mx-auto px-6 text-center mb-16">
            <div class="inline-block bg-primary-100 text-primary-700 font-bold px-4 py-1.5 rounded-full text-sm tracking-wide uppercase mb-6 shadow-sm">
                Tarifa de {categoriaLabel}
            </div>
            
            <h1 class="text-4xl md:text-5xl font-heading font-extrabold text-gray-900 tracking-tight">
                {tarifa.title}
            </h1>

            <p class="mt-6 text-gray-600 text-xl max-w-2xl mx-auto leading-relaxed">
                {tarifa.description}
            </p>
        </section>

        <section class="container mx-auto px-6 mb-20 max-w-5xl">
            <div class="grid md:grid-cols-2 gap-0 bg-white rounded-3xl shadow-xl ring-1 ring-black/5 overflow-hidden">
                
                <div class="p-10 lg:p-12 border-b md:border-b-0 md:border-r border-gray-100 bg-gray-50/50">
                    <h3 class="text-xl font-bold text-gray-900 mb-8 flex items-center gap-3">
                        Qué incluye esta tarifa
                    </h3>

                    <div class="space-y-6">
                        {
                            tarifa.features.map((f, i) => (
                                <div
                                    class="flex items-start gap-4 opacity-0 translate-y-2"
                                    data-anim={`feat-${i}`}
                                >
                                    <svg class="w-6 h-6 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    <p class="text-gray-700 text-lg leading-snug">{f}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <div class="p-10 lg:p-12 flex flex-col justify-center items-center text-center bg-white relative overflow-hidden">
                    
                    <div class="absolute -top-10 -right-10 text-gray-50 opacity-50 pointer-events-none">
                       {isFibra && (
                           <svg class="w-48 h-48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path></svg>
                       )}
                    </div>

                    <div class="relative z-10 w-full">
                        <h2 class="text-xl font-semibold text-gray-500 mb-4 uppercase tracking-wider">
                            Precio final
                        </h2>

                        <div class="flex items-baseline justify-center gap-1 mb-2">
                            <span class="text-6xl font-extrabold text-gray-900 tracking-tighter">{tarifa.price.split(',')[0]}</span>
                            <span class="text-3xl font-bold text-gray-900">,{tarifa.price.split(',')[1]}</span>
                        </div>
                        <p class="text-gray-500 font-medium mb-10">IVA incluido / mes</p>

                        <CTA
                            href="/contacto"
                            label="Contratar ahora"
                            variant="primary"
                            size="lg"
                            class="w-full shadow-lg shadow-primary-500/30 text-lg py-4"
                        />
                        
                        <p class="mt-4 text-xs text-gray-400">Instalación rápida garantizada</p>
                    </div>
                </div>
            </div>
        </section>

        <PreguntasSection preguntas={faqsTarifa} />

    </main>

    <script type="module" src={tarifaPageScript}></script>
    <script type="module" src={tarifaAnimScript}></script>
    <script type="module" src={preguntasScript}></script>

</Layout>