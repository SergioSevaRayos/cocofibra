---
import Layout from "../layouts/Layout.astro";
import config from "../data/site-config.json";
import { generateSchema } from "../lib/schemaGenerator.js";
import PreguntasSection from "../components/sections/preguntas/PreguntasSection.astro";
import faqs from "../data/faqs.json";
import contactScript from "../scripts/contact.js?url";
import preguntasScript from "../scripts/preguntas.js?url";

/* =========================================
   CREAMOS UN STRING CON LA DIRECCIÓN COMPLETA
========================================= */
const fullAddress = `${config.address.streetAddress}, ${config.address.postalCode} ${config.address.addressLocality}, ${config.address.addressRegion}`;

/* =========================================
   SCHEMA SEO (Añadimos LocalBusiness + FAQ)
========================================= */
const localBusinessSchema = generateSchema({ type: "LocalBusiness" }, config, Astro.url);
const faqSchema = generateSchema({ type: "FAQPage", data: { faqs: faqs.contacto } }, config, Astro.url);

// Pasamos ambos esquemas al Layout
const schema = [localBusinessSchema, faqSchema];
---

<Layout
  title={`Contacto | ${config.companyName}`}
  description={`Información de contacto, teléfono, email, dirección y ubicación de ${config.companyName}.`}
  schema={schema}
>
  <main class="pt-28 pb-24">
    <section
      class="container mx-auto px-6 text-center mb-16 tarifa-fade fade-in min-h-[160px]"
    >
      <h1 class="text-4xl font-heading font-bold text-primary-600">Contacto</h1>
      <p class="mt-3 text-accent-600 text-lg max-w-2xl mx-auto">
        ¿Tienes alguna duda o quieres comprobar tu cobertura? Habla con nosotros, te atenderemos de forma cercana y sin intermediarios.
      </p>
    </section>

    <section class="container mx-auto px-6 grid md:grid-cols-3 gap-8 mb-20">
      <div
        class="bg-secondary-50 shadow-gym-card p-8 rounded-2xl text-center hover:shadow-gym-lg transition-shadow contact-fade fade-in"
      >
        <img
          src="/icons/phone.webp"
          alt="Teléfono"
          class="w-10 h-10 mx-auto mb-4 opacity-90"
        />
        <p class="text-accent-700 font-medium mb-1">Teléfono</p>
        <a
          href={`tel:${config.phone.replace(/\s+/g, "")}`}
          class="text-xl text-primary-600 font-semibold hover:underline underline-offset-4"
        >
          {config.phone}
        </a>
      </div>

      <div
        class="bg-secondary-50 shadow-gym-card p-8 rounded-2xl text-center hover:shadow-gym-lg transition-shadow contact-fade fade-in"
      >
        <img
          src="/icons/email.webp"
          alt="Email"
          class="w-10 h-10 mx-auto mb-4 opacity-90"
        />
        <p class="text-accent-700 font-medium mb-1">Email</p>
        <a
          href={`mailto:${config.email}`}
          class="text-xl text-primary-600 font-semibold hover:underline underline-offset-4 break-all"
        >
          {config.email}
        </a>
      </div>

      <div
        class="bg-secondary-50 shadow-gym-card p-8 rounded-2xl text-center hover:shadow-gym-lg transition-shadow contact-fade fade-in flex flex-col justify-center"
      >
        <img
          src="/icons/address.webp"
          alt="Dirección"
          class="w-10 h-10 mx-auto mb-4 opacity-90"
        />
        <p class="text-accent-700 font-medium mb-1">Dirección</p>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-600 font-semibold hover:underline underline-offset-4 block contact-address leading-tight mt-1"
        >
          {config.address.streetAddress} <br/>
          <span class="text-sm font-normal text-gray-500">{config.address.postalCode} {config.address.addressLocality}</span>
        </a>
      </div>
    </section>

    <section
      class="container mx-auto px-6 max-w-xl mb-20 text-center contact-fade fade-in"
    >
      <h2 class="text-2xl font-heading font-semibold text-primary-600 mb-6">
        Datos legales de la empresa
      </h2>
      <p class="text-accent-700 leading-relaxed text-lg">
        <strong>{config.legalName} ({config.companyName})</strong><br />
        NIF: {config.nif}<br />
        {fullAddress}<br />
        Tel: {config.phone}<br />
        Email: {config.email}
      </p>
    </section>

    <section class="container mx-auto px-6 contact-fade fade-in">
      <div class="rounded-2xl overflow-hidden shadow-gym-lg h-[420px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3146.5666364009207!2d-1.1635687453478405!3d37.940553385972095!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd637f1a87423d99%3A0x8e933eb42287da4a!2sC.%20Mayor%2C%2073%2C%2030120%20Murcia!5e0!3m2!1ses!2ses!4v1771824155537!5m2!1ses!2ses"
          class="w-full h-full border-0"
          loading="lazy"
          allowfullscreen></iframe>
      </div>
    </section>

    <PreguntasSection preguntas={faqs.contacto} />

    <script type="module" src={contactScript}></script>
    <script type="module" src={preguntasScript}></script>
  </main>
</Layout>