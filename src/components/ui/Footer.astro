---
const year = new Date().getFullYear();
import { Image } from "astro:assets";
import logo2 from "/public/images/logo-cocofibra2.webp";
import config from "../../data/site-config.json";
---

<footer
  class="bg-white border-t border-gray-200 mt-20 pb-10 relative overflow-hidden"
>
  <div class="absolute inset-0 pointer-events-none opacity-60">
    <div
      class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-[450px] h-[450px] bg-primary-500/10 rounded-full blur-3xl"
    >
    </div>
  </div>

  <div
    class="container mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-4 gap-12 relative"
  >
    <div>
      <Image
        src={logo2}
        width={144}
        height={105}
        alt={config.companyName}
        loading="lazy"
        format="webp"
        class="w-36 mb-4"
      />

      <p class="text-gray-600 text-sm leading-relaxed mt-2">
        Fibra real, atención cercana y tarifas sin sorpresas. Conectamos tu
        hogar sin complicaciones.
      </p>

      <div class="flex gap-4 mt-6">
        <a href="#" class="footer-icon">
          <img
            src="/icons/facebook.webp"
            alt={`Facebook de ${config.companyName}`}
            class="w-6 h-6"
          />
        </a>
        <a href="#" class="footer-icon">
          <img
            src="/icons/instagram.webp"
            alt={`Instagram de ${config.companyName}`}
            class="w-6 h-6"
          />
        </a>
        <a href="#" class="footer-icon">
          <img
            src="/icons/twitter.webp"
            alt={`Twitter de ${config.companyName}`}
            class="w-6 h-6"
          />
        </a>
      </div>
    </div>

    <div>
      <h4 class="footer-title">Servicios</h4>
      <ul class="space-y-2 text-sm">
        <li><a class="footer-link" href="/tarifas">Tarifas</a></li>
        <li><a class="footer-link" href="/cobertura">Localidades</a></li>
        <li>
          <a class="footer-link" href="/preguntas">Preguntas frecuentes</a>
        </li>
        <li><a class="footer-link" href="/contacto">Contacto</a></li>
      </ul>
    </div>

    <div>
      <h4 class="footer-title">Soporte</h4>
      <ul class="space-y-3 text-sm">
        <li class="flex items-center gap-3">
          <img
            src="/icons/phone.webp"
            alt="Teléfono"
            class="w-5 h-5 opacity-80"
          />
          <a class="footer-link" href={`tel:+34${config.phone.replace(/\s+/g, '')}`}>
            {config.phone}
          </a>
        </li>

        <li class="flex items-center gap-3">
          <img src="/icons/email.webp" alt="Email" class="w-5 h-5 opacity-80" />
          <a class="footer-link" href={`mailto:${config.email}`}>
            {config.email}
          </a>
        </li>

        <li class="flex items-start gap-3">
          <img
            src="/icons/address.webp"
            alt="Dirección"
            class="w-5 h-5 opacity-80 mt-1"
          />
          <span class="text-gray-600 text-sm">
            Atención al cliente personalizada
          </span>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="footer-title">Legal</h4>
      <ul class="space-y-2 text-sm">
        <li>
          <a class="footer-link" href="/aviso-legal">Aviso legal</a>
        </li>
        <li>
          <a class="footer-link" href="/privacidad">Privacidad</a>
        </li>
        <li>
          <a class="footer-link" href="/cookies">Cookies</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-gray-200 py-6 text-center relative">
    <p class="text-sm text-gray-600">
      &copy; {year} {config.companyName} — Conexiones hechas para durar.
    </p>
  </div>
</footer>

<style is:global>
  .footer-title {
    @apply text-gray-900 font-semibold mb-4;
  }

  .footer-link {
    @apply text-gray-600 hover:text-primary-500 transition-colors;
  }

  .footer-icon {
    @apply inline-flex p-2 rounded-lg bg-gray-100 hover:bg-primary-500 hover:scale-110 transition-all;
  }

  .footer-icon img {
    @apply opacity-70 group-hover:opacity-100;
  }
</style>