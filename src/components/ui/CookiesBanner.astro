---
// src/components/ui/CookiesBanner.astro
---

<div
    id="cookies-banner"
    class="fixed bottom-4 left-4 right-4 md:left-auto md:right-6 md:w-[420px]
         bg-white shadow-gym-lg rounded-2xl p-6 z-50 hidden"
    role="dialog"
    aria-live="polite"
    aria-label="Aviso de cookies"
>
    <p class="text-sm text-gray-700 leading-relaxed mb-4">
        Utilizamos cookies técnicas para garantizar el correcto funcionamiento
        de la web. No usamos cookies de seguimiento ni publicidad.
    </p>

    <div class="flex gap-3 justify-end">
        <a
            href="/cookies"
            class="text-sm text-gray-600 underline underline-offset-4"
        >
            Más información
        </a>

        <button
            id="cookies-accept"
            class="bg-primary-500 text-white px-5 py-2 rounded-xl text-sm font-semibold
             hover:bg-primary-600 transition"
        >
            Aceptar
        </button>
    </div>
</div>

<script type="module" src="/src/scripts/cookies.js"></script>
