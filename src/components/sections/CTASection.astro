---
import CTA from "../ui/CTA.astro";
---

<section
    class="cta-section-solid py-28 text-white text-center"
    aria-labelledby="cta-title"
>
    <div class="relative container mx-auto px-6">
        
        <h2
            id="cta-title"
            class="text-3xl md:text-5xl font-bold mb-8 leading-tight"
        >
            ¿Listo para mejorar tu conexión?
        </h2>

        <p class="text-white/90 max-w-2xl mx-auto mb-12 text-lg">
            Obtén fibra real, estable y sin complicaciones.
            Te ayudamos a elegir la mejor tarifa.
        </p>

        <!-- CTA con doble pulso + halo expansivo -->
        <div class="cta-power-wrapper mx-auto">
            <div class="cta-halo"></div>

            <CTA
                href="/contacto"
                label="Contrata ya"
                size="lg"
                variant="cta"
                class="cta-power"
            />
        </div>

    </div>
</section>
