---
export interface Props {
    name: string;
    url: string;
    subtitle?: string;
}

const { name, url, subtitle } = Astro.props;
---

<article
    class="localidad-item bg-white rounded-2xl border border-gray-200 shadow-md
         p-6 flex flex-col items-center text-center
         transition-all duration-300 hover:shadow-xl hover:-translate-y-2 hover:border-primary-500/60"
>
    <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-1">
        {name}
    </h3>

    {subtitle && <p class="text-gray-600 text-sm mb-4">{subtitle}</p>}

    <a
        href={url}
        class="mt-auto w-full text-center bg-primary-500 text-white py-3 rounded-xl font-semibold
               hover:bg-primary-600 transition-all"
    >
        Ver cobertura
    </a>
</article>
