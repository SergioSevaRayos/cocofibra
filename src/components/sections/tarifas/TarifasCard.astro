---
import CTA from "../../ui/CTA.astro";

export interface Props {
  title: string;
  description: string;
  price: string;
  slug: string;
  features?: string[];
  category?: string;
  badge?: string;
  destacada?: boolean; // <-- Añadimos la propiedad destacada
}

/* =========================================
   DESTRUCTURING CORRECTO Y COMPLETO
========================================= */
const {
  title,
  description,
  price,
  slug,
  features = [],
  category = "fibra-movil",
  badge,
  destacada = false, // <-- Por defecto es false
} = Astro.props;

/* URL DINÁMICA A PARTIR DEL SLUG */
const url = `/tarifas/${slug}`;

/* Lógica de iconos según categoría */
const isFibra = category.includes("fibra");
const isMovil = category.includes("movil");

/* =========================================
   CLASES DINÁMICAS SI ES DESTACADA
========================================= */
const cardStyles = destacada
  ? "ring-2 ring-primary-500 shadow-2xl md:scale-105 z-10 border-primary-500 bg-gradient-to-b from-primary-50/30 to-white"
  : "border-gray-200 shadow-md bg-white hover:shadow-xl hover:-translate-y-1 hover:border-primary-500/50";
---

<article
  class={`tarifa-item relative rounded-2xl border p-8 flex flex-col transition-all duration-300 tarifa-fade ${cardStyles}`}
  data-category={category}
  role="article"
  aria-label={`Tarifa ${title}`}
  data-url={url}
>
  {destacada && (
    <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-primary-600 to-primary-500 text-white text-xs font-black px-5 py-1.5 rounded-full shadow-lg uppercase tracking-widest flex items-center gap-1.5 whitespace-nowrap">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
      </svg>
      Recomendada
    </div>
  )}

  {badge && !destacada && (
    <div class="absolute -top-3 left-6 bg-gray-800 text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-md uppercase tracking-wide">
      {badge}
    </div>
  )}

  <div class="flex items-center gap-3 mb-4 text-primary-500">
    {isFibra && (
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
      </svg>
    )}
    
    {isFibra && isMovil && (
      <span class="text-gray-300 font-bold text-xl">+</span>
    )}

    {isMovil && (
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
      </svg>
    )}
  </div>

  <h3 class="text-2xl font-extrabold text-gray-900 mb-2 leading-tight tracking-tight">{title}</h3>

  <p class="text-gray-500 text-sm mb-6 leading-relaxed min-h-[40px]">{description}</p>

  {
    features.length > 0 && (
      <ul class="space-y-3 mb-8 flex-grow">
        {features.map((f) => (
          <li class="flex items-start text-gray-700 text-sm">
            <svg class="w-5 h-5 text-accent-500 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="leading-snug">{f}</span>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto pt-6 border-t border-gray-100">
    <div class="text-center mb-6 flex flex-col items-center">
      <div class="flex items-baseline justify-center gap-1">
        <span class="text-5xl font-extrabold text-gray-900 tracking-tighter">{price.split(',')[0]}</span>
        <span class="text-2xl font-bold text-gray-900">,{price.split(',')[1]}</span>
      </div>
      <span class="text-gray-500 text-sm font-medium mt-1 uppercase tracking-wider">Precio definitivo / mes</span>
    </div>

    <CTA
      href={url}
      label="Quiero esta tarifa"
      variant={destacada ? "primary" : "secondary"}
      size="md"
      class={`w-full ${destacada ? "shadow-lg shadow-primary-500/30" : ""}`}
    />
  </div>
</article>