---
import NavigationDesktop from "./NavigationDesktop.astro";
import NavigationMobile from "./NavigationMobile.astro";
import { Image } from "astro:assets";
import logo3 from "/public/images/logo-cocofibra3.webp";
---

<header
  class="w-full fixed top-0 left-0 bg-white/90 backdrop-blur border-b border-gray-200 z-50 shadow-sm"
>
  <div class="container mx-auto px-4 py-3 flex items-center justify-between">
    <!-- LOGO -->
    <a href="/" class="flex items-center gap-2">
      <Image
        src={logo3}
        width={240}
        height={57}
        alt="CocoFibra"
        loading="lazy"
        format="webp"
        class="w-60 h-auto"
      />
    </a>

    <!-- NAV DESKTOP -->
    <div class="hidden md:flex">
      <NavigationDesktop />
    </div>
  </div>
</header>
<!-- BOTÓN MOBILE -->
<div class="md:hidden">
  <NavigationMobile />
</div>
