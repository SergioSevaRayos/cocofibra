---
import config from "../../data/site-config.json";
import CTA from "../../components/ui/CTA.astro";
import { Image } from "astro:assets";
import mascota from "/public/images/mascota-hero5.webp";
---

<section
    class="relative w-full min-h-[500px] bg-primary-500 flex items-center hero-section"
>
    <div
        class="container mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8 items-center"
    >
        <!-- COLUMNA CENTRAL (LCP TARGET) -->
        <div class="flex flex-col items-center text-center md:px-2 hero-main">
            <h1
                class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6"
            >
                En <span class="text-black">CocoFibra</span><br />
                nos comemos los precios
            </h1>

            <CTA
                href="/contacto"
                label="Contrata ya"
                size="lg"
                variant="primary"
                class="cta-hero"
            />
        </div>

        <!-- TARJETA IZQUIERDA -->
        <div class="hidden md:flex justify-center">
            <article
                class="hero-card bg-white text-accent-800 border border-black/10 rounded-2xl shadow-xl p-6 w-[260px] transition-all duration-300"
            >
                <h3 class="text-2xl font-bold text-primary-600 mb-1">
                    Fibra 300 Mb + 250 GB
                </h3>

                <div
                    class="badge bg-primary-500 text-white py-1 px-3 rounded-full inline-block text-sm font-semibold mb-4"
                >
                    300 Mb simétricos
                </div>

                <ul class="space-y-2 text-gray-700 text-sm mb-6">
                    <li class="flex items-center">
                        <span
                            class="bullet w-2 h-2 bg-primary-500 rounded-full mr-3"
                        ></span>250 GB + ilimitadas
                    </li>
                    <li class="flex items-center">
                        <span
                            class="bullet w-2 h-2 bg-primary-500 rounded-full mr-3"
                        ></span>300 mbps simétricos
                    </li>
                </ul>

                <div class="text-center mb-4">
                    <span class="precio-num text-3xl font-bold text-gray-900"
                        >41.00 €</span
                    >
                    <span class="precio-mes text-sm text-gray-500">/mes</span>
                </div>

                <a
                    href="/tarifas/fibra-300mb-movil-250gb"
                    class="cta-card block text-center bg-primary-500 text-white w-full py-3 rounded-xl font-bold transition-all"
                >
                    Más info
                </a>
            </article>
        </div>

        <!-- IMAGEN DERECHA OPTIMIZADA -->
        <div class="hidden md:flex justify-center">
            <Image
                src={mascota}
                alt="CocoFibra mascota"
                width={420}
                height={420}
                format="webp"
                loading="eager"
                class="w-[300px] md:w-[360px] lg:w-[320px] xl:w-[360px] max-w-full object-contain drop-shadow-xl"
            />
        </div>
    </div>
</section>
