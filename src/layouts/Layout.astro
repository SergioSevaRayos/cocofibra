---
import '../styles/global.css';
import Header from "../components/nav/Header.astro";      /* ruta corregida */
import Footer from "../components/ui/Footer.astro";
import CookiesBanner from "../components/ui/CookiesBanner.astro";          /* ruta corregida */
import config from '../data/site-config.json';
import menuScript from "../scripts/menu-toggle.js?url";

export interface Props {
    title?: string;
    description?: string;
    robots?: string;
    schema?: Record<string, any> | null;
}

const {
    title = `${config.companyName} — Internet Fibra y Móvil`,
    description = config.defaultDescription,
    robots = "index, follow",
    schema
} = Astro.props;
---

<!DOCTYPE html>
<html lang={config.siteLanguage}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={config.ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon2.webp" />

    <!-- JSON-LD Schema -->
    {schema && (
        <script type="application/ld+json">
            {JSON.stringify(schema)}
        </script>
    )}


</head>

<body class="bg-white text-accent flex flex-col min-h-screen">
    <Header />

    <main class="flex-grow">
        <slot />
    </main>

    <Footer />
</body>
<CookiesBanner />

<!-- Inicialización del body -->
<script is:inline>
window.addEventListener("load", () => {
    document.body.classList.add("cf-start");
});
</script>


<script type="module" src={menuScript} defer></script>



</html>
